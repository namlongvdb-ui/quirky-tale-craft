          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "notification_id": {
              "type": "string",
              "description": "The notification id to mark as read."
            }
          },
          "required": [
            "notification_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_voucher_signatures",
        "title": "Lịch sử ký duyệt",
